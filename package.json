{
  "name": "andresbetov-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,astro}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "check": "astro check",
    "verify": "npm run format:check && npm run lint && npm run stylelint && npm run check && npm run build"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "postcss-html": "2.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "18.1.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "wrangler": "4.166.0"
  }
}
