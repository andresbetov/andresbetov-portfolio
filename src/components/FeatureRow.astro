---
interface Props {
  iconSrc: string;
  label: string;
}

const { iconSrc, label } = Astro.props;
---

<li class="feature-row">
  <span class="feature-row-tile" aria-hidden="true">
    <img src={iconSrc} width="16" height="16" alt="" />
  </span>
  <span class="feature-row-label type-body-m">{label}</span>
</li>

<style>
  .feature-row {
    display: flex;
    min-block-size: 2rem;
    align-items: center;
    gap: var(--space-12);
  }

  .feature-row-tile {
    display: flex;
    inline-size: 2rem;
    block-size: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-security-soft);
    border-radius: 0.625rem;
    background-color: var(--color-tint-security-strong);
  }

  .feature-row-label {
    color: var(--color-text-secondary);
  }
</style>
