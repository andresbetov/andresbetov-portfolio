---
import type { Tier } from "../data/tiers";

interface Props {
  iconSrc?: string;
  label: string;
  emphasis?: string;
  variant?: "default" | "fact";
  tone?: Tier;
}

const {
  iconSrc,
  label,
  emphasis,
  variant = "default",
  tone = "edge",
} = Astro.props;
const isFact = variant === "fact";
---

<li class:list={["feature-row", isFact && "feature-row-fact"]}>
  {isFact ? (
    <span
      class:list={["feature-row-dot", `feature-row-dot-${tone}`]}
      aria-hidden="true"
    />
  ) : (
    iconSrc && (
      <span class="feature-row-tile" aria-hidden="true">
        <img src={iconSrc} width="16" height="16" alt="" />
      </span>
    )
  )}
  <span
    class:list={[
      "feature-row-label",
      isFact ? "type-body-fact" : "type-body-m",
      isFact && "feature-row-label-fact",
    ]}
  >
    {emphasis && <strong class="feature-row-emphasis">{emphasis}</strong>}
    {emphasis ? ` ${label}` : label}
  </span>
</li>

<style>
  .feature-row {
    display: flex;
    min-block-size: 2rem;
    align-items: center;
    gap: var(--space-12);
  }

  .feature-row-tile {
    display: flex;
    inline-size: 2rem;
    block-size: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-security-soft);
    border-radius: 0.625rem;
    background-color: var(--color-tint-security-strong);
  }

  .feature-row-label {
    color: var(--color-text-secondary);
  }

  .feature-row-fact {
    min-block-size: auto;
    gap: var(--space-10);
  }

  .feature-row-dot {
    inline-size: 0.3125rem;
    block-size: 0.3125rem;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .feature-row-dot-edge {
    background-color: var(--color-tier-edge);
    box-shadow: 0 0 0.375rem 1px var(--color-glow-stack-edge);
  }

  .feature-row-dot-services {
    background-color: var(--color-tier-services);
    box-shadow: 0 0 0.375rem 1px var(--color-glow-stack-services);
  }

  .feature-row-dot-data {
    background-color: var(--color-tier-data);
    box-shadow: 0 0 0.375rem 1px var(--color-glow-stack-data);
  }

  .feature-row-dot-security {
    background-color: var(--color-tier-security);
    box-shadow: 0 0 0.375rem 1px var(--color-glow-orbit);
  }

  .feature-row-dot-fault {
    background-color: var(--color-tier-fault);
    box-shadow: 0 0 0.375rem 1px var(--color-glow-coral);
  }

  .feature-row-label-fact {
    color: var(--color-text-secondary);
  }

  .feature-row-emphasis {
    color: var(--color-text-primary);
    font-weight: var(--weight-medium);
  }
</style>
