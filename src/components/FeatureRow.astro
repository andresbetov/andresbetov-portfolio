---
import type { DecisionContent } from "../data/elara";

interface Props {
  decision: DecisionContent;
}

const { decision } = Astro.props;
---

<li class="feature-row">
  <span class="feature-row-icon" aria-hidden="true">
    <img
      src={`/icons/sections/${decision.icon}.svg`}
      width="16"
      height="16"
      alt=""
    />
  </span>
  <span class="feature-row-label">{decision.label}</span>
</li>

<style>
  .feature-row {
    display: flex;
    min-block-size: 2rem;
    align-items: center;
    gap: var(--space-12);
  }

  .feature-row-icon {
    display: flex;
    inline-size: 2rem;
    block-size: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-security-soft);
    border-radius: 0.625rem;
    background-color: var(--color-tint-security-strong);
  }

  .feature-row-label {
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: var(--type-body-m-size);
    font-weight: var(--weight-regular);
    line-height: var(--type-body-m-line-height);
  }
</style>
