---
import Elara from "./Elara.astro";
import PortfolioEngine from "./PortfolioEngine.astro";
import SectionOpener from "./SectionOpener.astro";
import { projectsSection } from "../data/projects";
---

<section class="projects" id="projects" aria-labelledby="projects-title">
  <span class="projects-glow projects-glow-ambient" aria-hidden="true"></span>
  <div class="section-grid" aria-hidden="true"></div>
  <span class="projects-particles" aria-hidden="true"></span>

  <div class="projects-content shell-container">
    <SectionOpener id="projects-title" {...projectsSection} />
    <Elara />
  </div>

  <!-- PCE owns its full-bleed Figma background; its content uses the shell container. -->
  <PortfolioEngine />
</section>

<style>
  .projects {
    position: relative;
    overflow: clip;
    padding-block: 5rem 2.5rem;
  }

  /*
   * Figma Background "Glow – ambient". A blue light behind the masked grid at
   * the right edge, below the grid lines, particles, and content.
   */
  .projects-glow {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .projects-glow-ambient {
    inset-block-start: 29.375rem;
    inset-inline-start: calc(50% + 8.75rem);
    inline-size: 40rem;
    block-size: 28.75rem;
    border-radius: 50%;
    background-color: var(--color-glow-ambient);
    filter: blur(6rem);
  }

  /*
   * The Featured area continues the Hero's full-bleed particle field with the
   * Figma continuation layers. They fade in from the top so the Hero field and
   * the section field cross over without a hard horizontal edge.
   */
  .projects-particles {
    position: absolute;
    z-index: 2;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 18.75rem;
    background-image: url("/images/projects-particles-1440.svg");
    background-position: top center;
    background-repeat: repeat-x;
    background-size: 90rem 18.75rem;
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      var(--color-mask) 30%,
      var(--color-mask) 100%
    );
    pointer-events: none;
  }

  .projects-content {
    position: relative;
    z-index: 3;
  }

  @media (width >= 768px) and (width < 1200px) {
    .projects-glow-ambient {
      inset-block-start: 25rem;
      inset-inline-start: calc(100% - 27.5rem);
      inline-size: 35rem;
      block-size: 25rem;
    }

    .projects-particles {
      background-image: url("/images/projects-particles-768.svg");
      background-size: 48rem 18.75rem;
    }
  }

  @media (width >= 768px) and (width < 1280px) {
    .projects {
      padding-block-start: 3.5rem;
    }
  }

  @media (width <= 767.98px) {
    .projects {
      padding-block-start: 2.5rem;
    }

    .projects-glow-ambient {
      inset-block-start: 21.25rem;
      inset-inline-start: calc(100% - 15.625rem);
      inline-size: 26.25rem;
      block-size: 20rem;
    }

    .projects-particles {
      background-image: url("/images/projects-particles-390.svg");
      background-size: 24.375rem 18.75rem;
    }
  }
</style>
