---
import Elara from "./Elara.astro";
import SectionOpener from "./SectionOpener.astro";
import { projectsSection } from "../data/projects";
---

<section class="projects" id="projects" aria-labelledby="projects-title">
  <span class="projects-glow projects-glow-security" aria-hidden="true"></span>
  <span class="projects-glow projects-glow-edge" aria-hidden="true"></span>
  <div class="section-grid" aria-hidden="true"></div>
  <span class="projects-seam" aria-hidden="true"></span>
  <span class="projects-particles" aria-hidden="true"></span>

  <div class="projects-content shell-container">
    <SectionOpener id="projects-title" {...projectsSection} />
    <Elara />
  </div>
</section>

<style>
  .projects {
    position: relative;
    overflow: clip;
    padding-block: 5rem 2.5rem;
  }

  .projects-glow {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    filter: blur(140px);
    pointer-events: none;
  }

  .projects-glow-security {
    top: -11.25rem;
    right: -7.5rem;
    inline-size: 38.75rem;
    block-size: 28.75rem;
    background-color: var(--color-glow-orbit);
  }

  .projects-glow-edge {
    top: -10rem;
    left: -7.5rem;
    inline-size: 35rem;
    block-size: 26.25rem;
    background-color: var(--color-glow-name);
  }

  /*
   * The Featured area continues the Hero's atmosphere. The seam fade is the
   * Figma 237:217 gradient; the continuation particles are the Figma 683:495,
   * 684:3531 and 684:3547 layers so the Hero field does not stop at the seam.
   */
  .projects-seam {
    position: absolute;
    z-index: 1;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 26.25rem;
    background-image: linear-gradient(
      180deg,
      var(--color-bg-base) 0%,
      var(--color-seam-fade-strong) 35%,
      var(--color-seam-fade-mid) 70%,
      var(--color-seam-fade-clear) 100%
    );
    pointer-events: none;
  }

  .projects-particles {
    position: absolute;
    z-index: 2;
    inset-block-start: 0;
    inset-inline-start: 50%;
    inline-size: 90rem;
    block-size: 18.75rem;
    background-image: url("/images/projects-particles-1440.svg");
    background-position: top center;
    background-repeat: no-repeat;
    background-size: 90rem 18.75rem;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .projects-content {
    position: relative;
    z-index: 3;
  }

  @media (width >= 768px) and (width < 1200px) {
    .projects-particles {
      inline-size: 48rem;
      background-image: url("/images/projects-particles-768.svg");
      background-size: 48rem 18.75rem;
    }
  }

  @media (width >= 768px) and (width < 1280px) {
    .projects {
      padding-block-start: 3.5rem;
    }
  }

  @media (width <= 767.98px) {
    .projects {
      padding-block-start: 2.5rem;
    }

    .projects-glow-security {
      top: -8rem;
      right: -10rem;
      inline-size: 26rem;
      block-size: 20rem;
      filter: blur(100px);
    }

    .projects-glow-edge {
      top: -8rem;
      left: -10rem;
      inline-size: 24rem;
      block-size: 18rem;
      filter: blur(100px);
    }

    .projects-particles {
      inline-size: 24.375rem;
      background-image: url("/images/projects-particles-390.svg");
      background-size: 24.375rem 18.75rem;
    }
  }
</style>
