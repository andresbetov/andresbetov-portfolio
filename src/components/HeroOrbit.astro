---
import { orbit } from "../data/hero";
---

<div class="hero-orbit" role="group" aria-labelledby="orbit-title">
  <img
    class="orbit-ring orbit-ring-inner"
    src="/icons/hero/orbit-ring-inner.svg"
    width="280"
    height="280"
    alt=""
  />
  <img
    class="orbit-ring orbit-ring-outer"
    src="/icons/hero/orbit-ring-outer.svg"
    width="430"
    height="430"
    alt=""
  />
  <img
    class="orbit-spokes"
    src="/icons/hero/orbit-spokes.svg"
    width="1440"
    height="900"
    alt=""
  />
  <img
    class="orbit-core"
    src="/icons/hero/orbit-core.svg"
    width="168"
    height="168"
    alt=""
  />
  <h2 class="orbit-label" id="orbit-title">
    {orbit.labelLines[0]} <br />
    {orbit.labelLines[1]}
  </h2>

  <ul class="orbit-nodes">
    {orbit.nodes.map((node) => (
      <li
        class:list={[
          "orbit-node",
          `orbit-node-${node.id}`,
          `orbit-node-${node.tier}`,
        ]}
      >
        <span class="orbit-node-tile" aria-hidden="true">
          <img
            src={`/icons/hero/node-${node.icon}.svg`}
            width="16"
            height="16"
            alt=""
          />
        </span>
        <span class="orbit-node-copy">
          <span class="orbit-node-title">{node.title}</span>
          <span class="orbit-node-detail">{node.detail}</span>
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .hero-orbit {
    position: absolute;
    z-index: 0;
    top: calc(var(--header-offset) * -1);
    left: 50%;
    display: none;
    inline-size: 90rem;
    block-size: 56.25rem;
    transform: translateX(-50%);
  }

  .orbit-ring,
  .orbit-spokes,
  .orbit-core {
    position: absolute;
    pointer-events: none;
  }

  .orbit-ring-inner {
    top: 18.125rem;
    left: 64.375rem;
  }

  .orbit-ring-outer {
    top: 13.4375rem;
    left: 59.6875rem;
  }

  .orbit-spokes {
    top: 0;
    left: 0;
  }

  .orbit-core {
    top: 21.625rem;
    left: 67.875rem;
  }

  .orbit-label {
    position: absolute;
    top: 25.875rem;
    left: 73.125rem;
    width: 12.5rem;
    margin: 0;
    color: rgb(170 184 220 / 90%);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.16em;
    line-height: 1rem;
    text-align: center;
    transform: translateX(-50%);
  }

  .orbit-nodes {
    position: absolute;
    inset: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .orbit-node {
    position: absolute;
    display: flex;
    inline-size: 12.5rem;
    block-size: 3.25rem;
    align-items: center;
    padding: var(--space-10);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-2);
    gap: var(--space-8);
  }

  .orbit-node-tested {
    top: 11rem;
    left: 54.25rem;
  }

  .orbit-node-documented {
    top: 15.75rem;
    left: 74.5rem;
  }

  .orbit-node-reproducible {
    top: 36.5rem;
    left: 73.5rem;
  }

  .orbit-node-versioned {
    top: 40.625rem;
    left: 56.5rem;
  }

  .orbit-node-tile {
    display: flex;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
  }

  .orbit-node-edge .orbit-node-tile {
    background-color: var(--color-tier-edge);
  }

  .orbit-node-services .orbit-node-tile {
    background-color: var(--color-tier-services);
  }

  .orbit-node-data .orbit-node-tile {
    background-color: var(--color-tier-data);
  }

  .orbit-node-security .orbit-node-tile {
    background-color: var(--color-tier-security);
  }

  .orbit-node-copy {
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    gap: 1px;
  }

  .orbit-node-title {
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: var(--type-code-m-size);
    font-weight: var(--weight-medium);
    line-height: var(--type-code-m-line-height);
  }

  .orbit-node-detail {
    color: var(--color-text-tertiary);
    font-family: var(--font-body);
    font-size: var(--type-label-s-size);
    font-weight: var(--weight-medium);
    line-height: var(--type-label-s-line-height);
    white-space: nowrap;
  }

  /* The orbit canvas is 1440px wide; below 1360px the outer ring and the
     right-hand node would clip, so the diagram is desktop-only above that. */
  @media (width >= 1360px) {
    .hero-orbit {
      display: block;
    }
  }
</style>
