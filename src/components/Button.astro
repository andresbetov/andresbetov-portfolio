---
import type { ResourceLinkContent } from "../data/elara";

interface Props {
  link: ResourceLinkContent;
}

const { link } = Astro.props;
const arrow = link.variant === "primary" ? "arrow-primary" : "arrow-secondary";
---

<a
  class:list={["project-button", `project-button-${link.variant}`]}
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
>
  <img
    class="project-button-icon"
    src={`/icons/sections/${link.icon}.svg`}
    width="16"
    height="16"
    alt=""
  />
  <span class="project-button-label">
    {link.label}
    <span class="visually-hidden"> (opens in a new tab)</span>
  </span>
  <img
    class="project-button-arrow"
    src={`/icons/hero/${arrow}.svg`}
    width="14"
    height="14"
    alt=""
  />
</a>

<style>
  .project-button {
    display: flex;
    min-inline-size: 0;
    block-size: 3rem;
    flex: 0 0 auto;
    align-items: center;
    padding-inline: var(--space-16) var(--space-14);
    border-radius: var(--radius-full);
    gap: var(--space-10);
    font-family: var(--font-body);
    font-size: var(--type-label-m-size);
    font-weight: var(--weight-medium);
    line-height: var(--type-label-m-line-height);
  }

  .project-button-primary {
    background-color: var(--color-action-inverse);
    color: var(--color-text-on-light);
  }

  .project-button-secondary {
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-primary);
  }

  .project-button-secondary:hover {
    background-color: var(--color-surface-2);
  }

  .project-button-label {
    flex: 1;
    text-align: start;
    white-space: nowrap;
  }

  .project-button-icon,
  .project-button-arrow {
    flex-shrink: 0;
  }

  @media (width <= 767.98px) {
    .project-button {
      inline-size: 100%;
      flex: none;
    }
  }
</style>
