---
import type { SectionOpenerContent } from "../data/projects";

interface Props {
  content: SectionOpenerContent;
  id?: string;
}

const { content, id } = Astro.props;
---

<header class="section-opener">
  <p class="section-opener-eyebrow type-code-caps-m">
    <span class="section-opener-index">{content.eyebrowIndex}</span>
    <span class="section-opener-dash" aria-hidden="true"></span>
    <span class="section-opener-label">{content.eyebrowLabel}</span>
  </p>

  <h2
    class="section-opener-title type-section"
    id={id}
    tabindex="-1"
    data-nav-focus-target
  >
    {content.title}
  </h2>

  <div class="section-opener-rule">
    <span class="section-opener-node" aria-hidden="true">
      <img src="/icons/hero/scroll-node.svg" width="27" height="27" alt="" />
    </span>
    <span class="section-opener-line" aria-hidden="true"></span>
    <span class="section-opener-meta type-code-caps-m">{content.meta}</span>
  </div>
</header>

<style>
  .section-opener {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.375rem;
  }

  .section-opener-eyebrow {
    display: flex;
    align-items: center;
    margin: 0;
    gap: var(--space-14);
  }

  .section-opener-index {
    color: var(--color-tier-data);
  }

  .section-opener-dash {
    inline-size: 2.75rem;
    block-size: 1px;
    background-color: var(--color-line-amber);
  }

  .section-opener-label {
    color: var(--color-text-secondary);
  }

  .section-opener-title {
    margin: 0;
    color: var(--color-text-primary);
    font-variation-settings:
      "opsz" 14,
      "wdth" 90;
    scroll-margin-block-start: 2.375rem;
    background-image: linear-gradient(
      90deg,
      var(--color-ink-50) 0%,
      var(--color-ink-50) 60%,
      var(--color-name-end) 100%
    );
    background-clip: text;
    /* stylelint-disable-next-line property-no-vendor-prefix */
    -webkit-background-clip: text;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .section-opener-title {
      color: transparent;
    }
  }

  .section-opener-rule {
    display: flex;
    inline-size: 100%;
    align-items: center;
    gap: var(--space-16);
  }

  .section-opener-node {
    display: inline-flex;
    inline-size: 0.4375rem;
    block-size: 0.4375rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .section-opener-node img {
    max-inline-size: none;
  }

  .section-opener-line {
    flex: 1;
    block-size: 1px;
    background-image: linear-gradient(
      90deg,
      var(--color-line-amber) 0%,
      var(--color-line-ink-mid) 35%,
      var(--color-line-ink-end) 100%
    );
  }

  .section-opener-meta {
    color: var(--color-text-secondary);
    opacity: 0.85;
    white-space: nowrap;
  }

  /* Keep the Figma tablet scale until the 1440 desktop frame. */
  @media (width >= 1200px) and (width < 1440px) {
    .section-opener-title {
      font-size: 4rem;
      line-height: 4rem;
    }
  }

  @media (width >= 1440px) {
    .section-opener-title {
      font-variation-settings:
        "opsz" 14,
        "wdth" 87.5;
    }
  }
</style>
