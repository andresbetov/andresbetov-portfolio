---
import type { Tier } from "../data/tiers";

interface Props {
  tone: Tier;
  direction?: "down" | "right";
}

const { tone, direction = "down" } = Astro.props;
---

<svg
  class:list={["flow-arrow", `flow-arrow-${tone}`, `flow-arrow-${direction}`]}
  width={direction === "down" ? 8 : 18}
  height={direction === "down" ? 18 : 8}
  viewBox={direction === "down" ? "0 0 8 18" : "0 0 18 8"}
  fill="none"
  aria-hidden="true"
>
  {direction === "down" ? (
    <>
      <path d="M4 0V14" stroke="currentColor" stroke-width="1" />
      <path
        d="M1 11L4 15L7 11"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  ) : (
    <>
      <path d="M0 4H14" stroke="currentColor" stroke-width="1" />
      <path
        d="M11 1L15 4L11 7"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
</svg>

<style>
  .flow-arrow {
    flex-shrink: 0;
  }

  .flow-arrow-edge {
    color: var(--color-tier-edge);
  }

  .flow-arrow-services {
    color: var(--color-tier-services);
  }

  .flow-arrow-data {
    color: var(--color-tier-data);
  }

  .flow-arrow-fault {
    color: var(--color-tier-fault);
  }

  .flow-arrow-security {
    color: var(--color-tier-security);
  }
</style>
