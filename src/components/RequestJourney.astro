---
import DiagramNode from "./DiagramNode.astro";
import { elara } from "../data/elara";

const journey = elara.requestJourney;
const layouts = ["desktop", "tablet", "mobile"] as const;
---

<figure class="request-journey" aria-describedby="journey-connections">
  <div class="request-journey-top">
    <ul class="tech-stack" aria-label="Technology stack">
      {journey.stack.map((item) => (
        <li class:list={["tech-stack-cell", `tone-${item.tone}`]}>
          <span class="tech-stack-dot" aria-hidden="true"></span>
          <span class="tech-stack-label">{item.label}</span>
        </li>
      ))}
    </ul>

    <ul class="journey-legend" aria-label="Diagram legend">
      {journey.legend.map((item) => (
        <li class="journey-legend-item">
          <svg
            class="journey-legend-line"
            viewBox="0 0 28 8"
            aria-hidden="true"
            focusable="false"
          >
            <path
              class="journey-legend-line-path"
              d={
                item.style === "solid"
                  ? "M1 4H27"
                  : "M1 4H3.16667M27 4H24.8333M7.5 4H11.8333M16.1667 4H20.5"
              }
            />
          </svg>
          <span class="journey-legend-label">{item.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="journey-diagrams">
    {layouts.map((layout) => (
      <div class:list={["journey-canvas", `journey-canvas-${layout}`]}>
        {journey.bands.map((band) => (
          <section
            class:list={[
              "journey-band",
              `journey-band-${band.id}`,
              `tone-${band.tone}`,
            ]}
          >
            <p class="journey-band-label">{band.label}</p>
            <p class="journey-band-description">{band.description}</p>
            <ul class="journey-band-nodes" aria-label={`${band.label} nodes`}>
              {band.nodes.map((node) => (
                <li
                  class:list={["journey-node-slot", `journey-node-${node.id}`]}
                >
                  <DiagramNode
                    node={node}
                    featured={node.id === journey.focusNodeId}
                  />
                </li>
              ))}
            </ul>
          </section>
        ))}

        {layout === "desktop" && (
          <svg
            class="journey-connectors"
            viewBox="0 0 808 420"
            aria-hidden="true"
            focusable="false"
          >
            <defs>
              <marker
                id="arrow-request-desktop"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-request"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-platform-desktop"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-platform"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-validation-desktop"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-validation"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-data-desktop"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-data"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-secrets-desktop"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-secrets"
                  d="M0 0L6 4L0 8"
                />
              </marker>
            </defs>
            <path
              class="journey-connector journey-connector-request"
              d="M118 195H152"
              marker-end="url(#arrow-request-desktop)"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M298 182C315 182 315 90 334 90"
              marker-end="url(#arrow-platform-desktop)"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M298 195C315 195 315 160 334 160"
              marker-end="url(#arrow-platform-desktop)"
            />
            <path
              class="journey-connector journey-connector-request"
              d="M298 202C315 202 315 230 334 230"
              marker-end="url(#arrow-request-desktop)"
            />
            <path
              class="journey-connector journey-connector-request"
              d="M298 212C315 212 315 300 334 300"
              marker-end="url(#arrow-request-desktop)"
            />
            <path
              class="journey-connector journey-connector-validation"
              d="M457 256V274"
              marker-end="url(#arrow-validation-desktop)"
            />
            <path
              class="journey-connector journey-connector-data"
              d="M580 230H620"
              marker-end="url(#arrow-data-desktop)"
            />
            <path
              class="journey-connector journey-connector-secrets"
              d="M580 230C600 230 600 300 620 300"
              marker-end="url(#arrow-secrets-desktop)"
            />
            <path
              class="journey-connector journey-connector-secrets"
              d="M580 300H620"
              marker-end="url(#arrow-secrets-desktop)"
            />
            <path
              class="journey-connector journey-connector-data"
              d="M580 300C600 300 600 370 620 370"
              marker-end="url(#arrow-data-desktop)"
            />
          </svg>
        )}

        {layout === "tablet" && (
          <svg
            class="journey-connectors"
            viewBox="0 0 630 568"
            aria-hidden="true"
            focusable="false"
          >
            <defs>
              <marker
                id="arrow-request-tablet"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-request"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-platform-tablet"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-platform"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-validation-tablet"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-validation"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-data-tablet"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-data"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-secrets-tablet"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-secrets"
                  d="M0 0L6 4L0 8"
                />
              </marker>
            </defs>
            <path
              class="journey-connector journey-connector-request"
              d="M123 85H189"
              marker-end="url(#arrow-request-tablet)"
            />
            <path
              class="journey-connector journey-connector-request"
              d="M273 127V146Q273 150 269 150H25Q21 150 21 154V455Q21 459 25 459H39"
              marker-end="url(#arrow-request-tablet)"
            />
            <path
              class="journey-connector journey-connector-request"
              d="M21 389H39"
              marker-end="url(#arrow-request-tablet)"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M31 150V319"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M31 249H39"
              marker-end="url(#arrow-platform-tablet)"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M31 319H39"
              marker-end="url(#arrow-platform-tablet)"
            />
            <path
              class="journey-connector journey-connector-validation"
              d="M192 415V433"
              marker-end="url(#arrow-validation-tablet)"
            />
            <path
              class="journey-connector journey-connector-data"
              d="M345 389H431"
              marker-end="url(#arrow-data-tablet)"
            />
            <path
              class="journey-connector journey-connector-secrets"
              d="M345 397C380 397 395 449 431 449"
              marker-end="url(#arrow-secrets-tablet)"
            />
            <path
              class="journey-connector journey-connector-secrets"
              d="M345 467H431"
              marker-end="url(#arrow-secrets-tablet)"
            />
            <path
              class="journey-connector journey-connector-data"
              d="M345 473C380 473 395 529 431 529"
              marker-end="url(#arrow-data-tablet)"
            />
          </svg>
        )}

        {layout === "mobile" && (
          <svg
            class="journey-connectors"
            viewBox="0 0 308 906"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
          >
            <defs>
              <marker
                id="arrow-request-mobile"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-request"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-platform-mobile"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-platform"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-validation-mobile"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-validation"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-data-mobile"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-data"
                  d="M0 0L6 4L0 8"
                />
              </marker>
              <marker
                id="arrow-secrets-mobile"
                viewBox="0 0 6 8"
                refX="5.5"
                refY="4"
                markerWidth="6"
                markerHeight="8"
                orient="auto"
              >
                <path
                  class="journey-arrow journey-arrow-secrets"
                  d="M0 0L6 4L0 8"
                />
              </marker>
            </defs>
            <path
              class="journey-connector journey-connector-request"
              d="M154 124V148"
              marker-end="url(#arrow-request-mobile)"
            />
            <path
              class="journey-connector journey-connector-request"
              d="M19 259V587Q19 591 23 591H35"
              marker-end="url(#arrow-request-mobile)"
            />
            <path
              class="journey-connector journey-connector-request"
              d="M19 521H35"
              marker-end="url(#arrow-request-mobile)"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M26 259V451"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M26 381H35"
              marker-end="url(#arrow-platform-mobile)"
            />
            <path
              class="journey-connector journey-connector-platform"
              d="M26 451H35"
              marker-end="url(#arrow-platform-mobile)"
            />
            <path
              class="journey-connector journey-connector-validation"
              d="M152 547V565"
              marker-end="url(#arrow-validation-mobile)"
            />
            <path
              class="journey-connector journey-connector-data"
              d="M269 529H273Q277 529 277 533V735Q277 739 273 739H269"
              marker-end="url(#arrow-data-mobile)"
            />
            <path
              class="journey-connector journey-connector-secrets"
              d="M269 513H287Q291 513 291 517V787Q291 791 287 791H269"
              marker-end="url(#arrow-secrets-mobile)"
            />
            <path
              class="journey-connector journey-connector-secrets"
              d="M269 599H280Q284 599 284 603V803Q284 807 280 807H269"
              marker-end="url(#arrow-secrets-mobile)"
            />
            <path
              class="journey-connector journey-connector-data"
              d="M269 583H294Q298 583 298 587V860Q298 864 294 864H269"
              marker-end="url(#arrow-data-mobile)"
            />
          </svg>
        )}
      </div>
    ))}
  </div>

  <figcaption class="journey-caption">
    <p class="journey-caption-label">
      <span class="journey-caption-dot" aria-hidden="true"></span>
      {journey.captionLabel}
    </p>
    <p class="journey-caption-text">{journey.caption}</p>
  </figcaption>

  <p class="visually-hidden" id="journey-connections">
    {journey.connectionSummary}
  </p>
</figure>

<style>
  .request-journey {
    display: flex;
    flex-direction: column;
    margin: 0;
    gap: var(--space-20);
  }

  .request-journey-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.125rem;
  }

  .tech-stack {
    display: flex;
    max-inline-size: 100%;
    align-items: stretch;
    overflow: hidden;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background-color: var(--color-surface-2);
    list-style: none;
  }

  .tech-stack-cell {
    display: flex;
    min-block-size: 1.875rem;
    align-items: center;
    padding: var(--space-8) var(--space-14);
    gap: var(--space-8);
  }

  .tech-stack-cell + .tech-stack-cell {
    border-inline-start: 1px solid var(--color-border-strong);
  }

  .tech-stack-dot {
    inline-size: 0.375rem;
    block-size: 0.375rem;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .tone-edge .tech-stack-dot {
    background-color: var(--color-tier-edge);
  }

  .tone-services .tech-stack-dot {
    background-color: var(--color-tier-services);
  }

  .tone-data .tech-stack-dot {
    background-color: var(--color-tier-data);
  }

  .tech-stack-label {
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    line-height: 0.875rem;
    white-space: nowrap;
  }

  .journey-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    padding: 0;
    margin: 0;
    gap: var(--space-24);
    list-style: none;
  }

  .journey-legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-10);
  }

  .journey-legend-line {
    inline-size: 1.75rem;
    block-size: 0.5rem;
    flex-shrink: 0;
    overflow: visible;
  }

  .journey-legend-line-path {
    fill: none;
    stroke: var(--color-text-secondary);
    stroke-linecap: round;
    stroke-width: 2;
  }

  .journey-legend-label {
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: var(--type-label-s-size);
    font-weight: var(--weight-medium);
    line-height: var(--type-label-s-line-height);
    white-space: nowrap;
  }

  .journey-diagrams {
    position: relative;
  }

  .journey-canvas {
    position: relative;
    display: none;
    margin-inline: auto;
  }

  .journey-canvas-desktop {
    inline-size: 50.5rem;
    block-size: 26.25rem;
  }

  .journey-canvas-tablet {
    inline-size: 39.375rem;
    block-size: 35.5rem;
  }

  .journey-canvas-mobile {
    inline-size: 100%;
    block-size: 56.625rem;
  }

  .journey-band {
    position: absolute;
  }

  .journey-band::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    border: 1px solid;
    border-radius: var(--radius-lg);
    content: "";
  }

  .journey-band.tone-edge::before {
    border-color: var(--color-border-edge-soft);
    background-color: var(--color-tint-edge);
  }

  .journey-band.tone-services::before {
    border-color: var(--color-border-services-soft);
    background-color: var(--color-tint-services);
  }

  .journey-band.tone-data::before {
    border-color: var(--color-border-data-soft);
    background-color: var(--color-tint-data);
  }

  .journey-band-label,
  .journey-band-description,
  .journey-band-nodes {
    position: absolute;
    z-index: 2;
  }

  .journey-band-label {
    display: flex;
    align-items: center;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-label-s-size);
    font-weight: var(--weight-medium);
    gap: var(--space-8);
    line-height: var(--type-label-s-line-height);
    white-space: nowrap;
  }

  .journey-band-label::before {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: currentcolor;
    content: "";
  }

  .tone-edge .journey-band-label {
    color: var(--color-tier-edge);
  }

  .tone-edge .journey-band-label::before {
    box-shadow: 0 0 0 3px var(--color-tint-edge);
  }

  .tone-services .journey-band-label {
    color: var(--color-tier-services);
  }

  .tone-services .journey-band-label::before {
    box-shadow: 0 0 0 3px var(--color-tint-services);
  }

  .tone-data .journey-band-label {
    color: var(--color-tier-data);
  }

  .tone-data .journey-band-label::before {
    box-shadow: 0 0 0 3px var(--color-tint-data);
  }

  .journey-band-description {
    margin: 0;
    color: var(--color-text-tertiary);
    font-family: var(--font-body);
    font-size: var(--type-label-s-size);
    font-weight: var(--weight-regular);
    line-height: var(--type-label-s-line-height);
  }

  .journey-band-nodes {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .journey-node-slot {
    position: absolute;
    inset-inline: 0;
    block-size: 3.25rem;
  }

  .journey-canvas-desktop .journey-band-client {
    top: 0;
    left: 0;
    inline-size: 8rem;
    block-size: 26.25rem;
  }

  .journey-canvas-desktop .journey-band-edge {
    top: 0;
    left: 9rem;
    inline-size: 10.125rem;
    block-size: 26.25rem;
  }

  .journey-canvas-desktop .journey-band-services {
    top: 0;
    left: 20.125rem;
    inline-size: 16.875rem;
    block-size: 26.25rem;
  }

  .journey-canvas-desktop .journey-band-data {
    top: 0;
    left: 38rem;
    inline-size: 12.5rem;
    block-size: 26.25rem;
  }

  .journey-canvas-desktop .journey-band-label {
    top: 0.6875rem;
    left: 0.9375rem;
  }

  .journey-canvas-desktop .journey-band-description {
    top: 2rem;
    left: 0.9375rem;
    inline-size: calc(100% - 1.875rem);
  }

  .journey-canvas-desktop .journey-band-client .journey-band-nodes {
    top: 10.5625rem;
    left: 0.625rem;
    inline-size: 6.75rem;
    block-size: 3.25rem;
  }

  .journey-canvas-desktop .journey-band-edge .journey-band-nodes {
    top: 10.5625rem;
    left: 0.5rem;
    inline-size: 9.125rem;
    block-size: 3.25rem;
  }

  .journey-canvas-desktop .journey-band-services .journey-band-nodes {
    top: 4rem;
    left: 0.75rem;
    inline-size: 15.375rem;
    block-size: 16.375rem;
  }

  .journey-canvas-desktop .journey-band-data .journey-band-nodes {
    top: 12.75rem;
    left: 0.75rem;
    inline-size: 11rem;
    block-size: 12rem;
  }

  .journey-canvas-desktop .journey-node-client,
  .journey-canvas-desktop .journey-node-api-gateway,
  .journey-canvas-desktop .journey-node-config-service,
  .journey-canvas-desktop .journey-node-inventory-db {
    top: 0;
  }

  .journey-canvas-desktop .journey-node-discovery-service,
  .journey-canvas-desktop .journey-node-vault {
    top: 4.375rem;
  }

  .journey-canvas-desktop .journey-node-inventory-service,
  .journey-canvas-desktop .journey-node-unit-of-measure-db {
    top: 8.75rem;
  }

  .journey-canvas-desktop .journey-node-unit-of-measure-service {
    top: 13.125rem;
  }

  .journey-canvas-tablet .journey-band-client {
    top: 0;
    left: 0;
    inline-size: 8.5rem;
    block-size: 8.75rem;
  }

  .journey-canvas-tablet .journey-band-edge {
    top: 0;
    left: 11rem;
    inline-size: 12.125rem;
    block-size: 8.75rem;
  }

  .journey-canvas-tablet .journey-band-services {
    top: 10.25rem;
    left: 0;
    inline-size: 23.125rem;
    block-size: 25.25rem;
  }

  .journey-canvas-tablet .journey-band-data {
    top: 0;
    left: 26.125rem;
    inline-size: 13.25rem;
    block-size: 35.5rem;
  }

  .journey-canvas-tablet .journey-band-label {
    top: 0.8125rem;
    left: 1.0625rem;
  }

  .journey-canvas-tablet .journey-band-description {
    top: 2.0625rem;
    left: 1.0625rem;
    inline-size: calc(100% - 1.875rem);
  }

  .journey-canvas-tablet .journey-band-services .journey-band-label,
  .journey-canvas-tablet .journey-band-services .journey-band-description {
    left: 2.4375rem;
  }

  .journey-canvas-tablet .journey-band-services .journey-band-description {
    inline-size: calc(100% - 3.25rem);
  }

  .journey-canvas-tablet .journey-band-client .journey-band-nodes {
    top: 3.6875rem;
    left: 0.8125rem;
    inline-size: 6.875rem;
    block-size: 3.25rem;
  }

  .journey-canvas-tablet .journey-band-edge .journey-band-nodes {
    top: 4.6875rem;
    left: 0.8125rem;
    inline-size: 10.5rem;
